# Copy to config.env and fill in. A real environment variable wins over this file.
# Path to the main clone of the repo being coordinated. On Windows, C:/path and
# Git Bash's /c/path both work.
ZM_REPO=/path/to/your/repo
# Migrations folder, relative to that repo.
ZM_MIG_DIR=migrations
# The slug reserved for you. Agents can't post as this name; you post through the dashboard.
ZM_HUMAN=human
# owner/name on GitHub. Leave empty to skip every GitHub call.
ZM_PR_REPO=
