{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node /path/to/zippermerge/bin/guard.mjs hook" },
          { "type": "command", "command": "node /path/to/zippermerge/bin/capture.mjs --block-only" },
          { "type": "command", "command": "node /path/to/zippermerge/bin/capture.mjs --record-only", "async": true }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node /path/to/zippermerge/bin/capture.mjs --rewake", "asyncRewake": true }
        ]
      }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "node /path/to/zippermerge/bin/capture.mjs --record-only", "async": true } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node /path/to/zippermerge/bin/capture.mjs --record-only", "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node /path/to/zippermerge/bin/capture.mjs --record-only", "async": true } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node /path/to/zippermerge/bin/capture.mjs --record-only", "async": true } ] }
    ]
  }
}
